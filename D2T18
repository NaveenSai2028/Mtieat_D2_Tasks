// class Student
class Student {
    String name;
    double marks;

    // parameterized constructor using this keyword
    Student(String name, double marks) {
        this.name = name;
        this.marks = marks;
    }

    // method to print student name and marks
    void showResult() {
        System.out.println("Name: " + name + ", Marks: " + marks);
    }
}

// main class
public class Main {
    public static void main(String[] args) {
        // creating two Student objects
        Student s1 = new Student("Naveen", 85.5);
        Student s2 = new Student("Likhith", 91.0);

        // calling showResult on both objects
        s1.showResult();
        s2.showResult();
    }
}
