// class Rectangle
class Rectangle {
    double length;
    double width;

    // no-argument constructor
    Rectangle() {
        length = 1.0;
        width = 1.0;
    }

    // constructor with one parameter for square
    Rectangle(double side) {
        length = side;
        width = side;
    }

    // constructor with two parameters
    Rectangle(double length, double width) {
        this.length = length;
        this.width = width;
    }

    // method to calculate and print area
    void calculateArea() {
        System.out.println("Area: " + (length * width));
    }
}

// main class
public class Main {
    public static void main(String[] args) {
        // creating three objects using all three constructors
        Rectangle r1 = new Rectangle();
        Rectangle r2 = new Rectangle(5.0);
        Rectangle r3 = new Rectangle(4.0, 6.0);

        // calling calculateArea on each object
        r1.calculateArea();
        r2.calculateArea();
        r3.calculateArea();
    }
}
