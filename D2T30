class Course {
    String courseName;
    int duration;
    double fee;

    Course(String courseName, int duration, double fee) {
        this.courseName = courseName;
        this.duration = duration;
        this.fee = fee;
    }

    void displayCourse() {
        System.out.println("Course: " + courseName + " | Duration: " + duration + " months | Fee: " + fee);
    }
}

public class Main {
    public static void main(String[] args) {
        Course c1 = new Course("Java Full Stack", 6, 35000);
        Course c2 = new Course("AI & Data Science", 8, 45000);

        c1.displayCourse();
        c2.displayCourse();
    }
}
