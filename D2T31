class Product {
    String productName;
    int quantity;
    double price;

    Product() {
        productName = "Unknown";
        quantity = 1;
        price = 100;
    }

    Product(String productName) {
        this.productName = productName;
        this.quantity = 1;
        this.price = 100;
    }

    Product(String productName, int quantity, double price) {
        this.productName = productName;
        this.quantity = quantity;
        this.price = price;
    }

    void calculateTotal() {
        System.out.println("Product: " + productName + " | Total Price: ₹" + (quantity * price));
    }
}

public class Main {
    public static void main(String[] args) {
        Product p1 = new Product();
        Product p2 = new Product("Wireless Mouse");
        Product p3 = new Product("Mechanical Keyboard", 2, 2500);

        p1.calculateTotal();
        p2.calculateTotal();
        p3.calculateTotal();
    }
}
