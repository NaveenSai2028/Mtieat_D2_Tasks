    public void register(String name, int userId) {
        System.out.println("Registered user: " + name + " with ID: " + userId);
    }

    public void register(int userId, String name) {
        System.out.println("Registered ID: " + userId + " for user: " + name);
    }
}

// Task 6: Book
class Book {
    String title;
    double price;

    public Book() {
        this.title = "Unknown";
        this.price = 0.0;
    }

    public Book(String title) {
        this.title = title;
        this.price = 0.0;
    }

    public Book(String title, double price) {
        this.title = title;
        this.price = price;
    }

    public void display() {
        System.out.println("Title: " + title + ", Price: " + price);
    }
}

// Task 7: Employee and SalesEmployee
class Employee {
    double baseSalary;

    public double calculateSalary() {
        return baseSalary;
    }
}

class SalesEmployee extends Employee {
    double bonus;

    @Override
    public double calculateSalary() {
        return super.calculateSalary() + bonus;
    }
}

// Task 8: Payment, CreditCard, and UPI
class Payment {
    public void pay(double amount) {
        System.out.println("Processing generic payment of ₹" + amount);
    }
}

class CreditCard extends Payment {
    @Override
    public void pay(double amount) {
        System.out.println("Paid ₹" + amount + " via Credit Card");
    }
}

class UPI extends Payment {
    @Override
    public void pay(double amount) {
        System.out.println("Paid ₹" + amount + " via UPI");
    }
}

